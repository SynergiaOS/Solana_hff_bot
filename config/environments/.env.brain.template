# THE OVERMIND PROTOCOL - AI Brain Configuration Template
# Copy this file to .env.brain and configure your settings

# =============================================================================
# AI BRAIN CORE SETTINGS
# =============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000

# Alternative LLM Providers (optional)
# GROQ_API_KEY=your_groq_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# =============================================================================
# VECTOR MEMORY CONFIGURATION
# =============================================================================

# Chroma Vector Database
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=overmind_memory
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Memory Settings
MEMORY_MAX_EXPERIENCES=10000
MEMORY_SIMILARITY_THRESHOLD=0.7
MEMORY_CLEANUP_INTERVAL=3600  # seconds

# =============================================================================
# DRAGONFLY/REDIS COMMUNICATION
# =============================================================================

# DragonflyDB Connection
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DB=0

# Communication Channels
OVERMIND_MARKET_EVENTS_CHANNEL=overmind:market_events
OVERMIND_TRADING_COMMANDS_CHANNEL=overmind:trading_commands
OVERMIND_BRAIN_STATUS_CHANNEL=overmind:brain_status

# =============================================================================
# RISK MANAGEMENT SETTINGS
# =============================================================================

# Risk Analyzer Configuration
MAX_PORTFOLIO_RISK=0.02          # 2% max portfolio risk per trade
MAX_POSITION_SIZE=0.1            # 10% max position size
VOLATILITY_THRESHOLD=0.05        # 5% volatility threshold
CORRELATION_THRESHOLD=0.7        # 70% correlation threshold

# Decision Confidence Thresholds
MIN_DECISION_CONFIDENCE=0.6      # 60% minimum confidence to execute
HIGH_CONFIDENCE_THRESHOLD=0.8    # 80% high confidence threshold
EXTREME_RISK_OVERRIDE=true       # Override decisions on extreme risk

# =============================================================================
# MARKET ANALYZER SETTINGS
# =============================================================================

# Technical Analysis
LOOKBACK_PERIODS=20              # Number of periods for analysis
VOLATILITY_WINDOW=14             # Window for volatility calculation
MOMENTUM_WINDOW=10               # Window for momentum calculation

# Pattern Recognition
ENABLE_PATTERN_DETECTION=true
TREND_STRENGTH_THRESHOLD=0.7
SUPPORT_RESISTANCE_LEVELS=3

# =============================================================================
# AI BRAIN SERVER CONFIGURATION
# =============================================================================

# FastAPI Server
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000
BRAIN_RELOAD=false
BRAIN_LOG_LEVEL=info

# Health Check Settings
HEALTH_CHECK_INTERVAL=30         # seconds
STATUS_UPDATE_INTERVAL=60        # seconds

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log Files
LOG_DIR=./logs
BRAIN_LOG_FILE=overmind_brain.log
DECISION_LOG_FILE=ai_decisions.log
MEMORY_LOG_FILE=vector_memory.log

# Log Rotation
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Development Mode
DEBUG_MODE=false
ENABLE_DEBUG_ENDPOINTS=false
MOCK_EXTERNAL_APIS=false

# Performance Monitoring
ENABLE_METRICS=true
METRICS_COLLECTION_INTERVAL=60   # seconds

# Testing Configuration
TEST_MODE=false
TEST_DRAGONFLY_HOST=localhost
TEST_DRAGONFLY_PORT=6380

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Security
ENABLE_API_KEY_AUTH=false
API_KEY=your_secure_api_key_here

# Rate Limiting
RATE_LIMIT_REQUESTS=100          # requests per minute
RATE_LIMIT_WINDOW=60             # seconds

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================

# TensorZero Integration (if available)
TENSORZERO_ENABLED=false
TENSORZERO_API_URL=http://localhost:3000
TENSORZERO_API_KEY=your_tensorzero_key

# External Data Sources
ENABLE_NEWS_SENTIMENT=false
NEWS_API_KEY=your_news_api_key

# Monitoring Integration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# =============================================================================
# ADVANCED AI SETTINGS
# =============================================================================

# Multi-Agent Configuration
ENABLE_MULTI_AGENT=true
NUM_DECISION_AGENTS=3
AGENT_CONSENSUS_THRESHOLD=0.6

# Learning Configuration
ENABLE_CONTINUOUS_LEARNING=true
LEARNING_RATE=0.01
EXPERIENCE_REPLAY_SIZE=1000

# Model Fine-tuning
ENABLE_MODEL_FINETUNING=false
FINETUNING_DATA_PATH=./data/finetuning
FINETUNING_INTERVAL=86400        # 24 hours in seconds

# =============================================================================
# ENVIRONMENT SPECIFIC OVERRIDES
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Production Overrides
# OPENAI_MODEL=gpt-4-turbo
# MIN_DECISION_CONFIDENCE=0.8
# LOG_LEVEL=WARNING

# Staging Overrides
# TEST_MODE=true
# DEBUG_MODE=true
# MOCK_EXTERNAL_APIS=true
