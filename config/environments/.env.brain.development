# THE OVERMIND PROTOCOL - AI Brain Development Configuration
# Development environment settings for safe testing

# =============================================================================
# AI BRAIN CORE SETTINGS
# =============================================================================

# OpenAI API Configuration (use your actual key)
OPENAI_API_KEY=sk-your-development-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1500

# =============================================================================
# VECTOR MEMORY CONFIGURATION
# =============================================================================

# Chroma Vector Database
CHROMA_PERSIST_DIRECTORY=./data/dev/chroma_db
CHROMA_COLLECTION_NAME=overmind_memory_dev
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Memory Settings (smaller for development)
MEMORY_MAX_EXPERIENCES=1000
MEMORY_SIMILARITY_THRESHOLD=0.6
MEMORY_CLEANUP_INTERVAL=1800

# =============================================================================
# DRAGONFLY/REDIS COMMUNICATION
# =============================================================================

# DragonflyDB Connection
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DB=1  # Use different DB for development

# Communication Channels
OVERMIND_MARKET_EVENTS_CHANNEL=overmind:dev:market_events
OVERMIND_TRADING_COMMANDS_CHANNEL=overmind:dev:trading_commands
OVERMIND_BRAIN_STATUS_CHANNEL=overmind:dev:brain_status

# =============================================================================
# RISK MANAGEMENT SETTINGS (Conservative for development)
# =============================================================================

# Risk Analyzer Configuration
MAX_PORTFOLIO_RISK=0.01          # 1% max portfolio risk per trade
MAX_POSITION_SIZE=0.05           # 5% max position size
VOLATILITY_THRESHOLD=0.03        # 3% volatility threshold
CORRELATION_THRESHOLD=0.8        # 80% correlation threshold

# Decision Confidence Thresholds
MIN_DECISION_CONFIDENCE=0.7      # 70% minimum confidence
HIGH_CONFIDENCE_THRESHOLD=0.85   # 85% high confidence threshold
EXTREME_RISK_OVERRIDE=true

# =============================================================================
# MARKET ANALYZER SETTINGS
# =============================================================================

# Technical Analysis
LOOKBACK_PERIODS=10              # Shorter for development
VOLATILITY_WINDOW=7
MOMENTUM_WINDOW=5

# Pattern Recognition
ENABLE_PATTERN_DETECTION=true
TREND_STRENGTH_THRESHOLD=0.6
SUPPORT_RESISTANCE_LEVELS=2

# =============================================================================
# AI BRAIN SERVER CONFIGURATION
# =============================================================================

# FastAPI Server
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8001  # Different port for development
BRAIN_RELOAD=true
BRAIN_LOG_LEVEL=debug

# Health Check Settings
HEALTH_CHECK_INTERVAL=15
STATUS_UPDATE_INTERVAL=30

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels
LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log Files
LOG_DIR=./logs/dev
BRAIN_LOG_FILE=overmind_brain_dev.log
DECISION_LOG_FILE=ai_decisions_dev.log
MEMORY_LOG_FILE=vector_memory_dev.log

# Log Rotation
LOG_MAX_SIZE=5MB
LOG_BACKUP_COUNT=3

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Development Mode
DEBUG_MODE=true
ENABLE_DEBUG_ENDPOINTS=true
MOCK_EXTERNAL_APIS=false

# Performance Monitoring
ENABLE_METRICS=true
METRICS_COLLECTION_INTERVAL=30

# Testing Configuration
TEST_MODE=false
TEST_DRAGONFLY_HOST=localhost
TEST_DRAGONFLY_PORT=6380

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# API Security (disabled for development)
ENABLE_API_KEY_AUTH=false
API_KEY=dev-key-12345

# Rate Limiting (relaxed for development)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# =============================================================================
# INTEGRATION SETTINGS
# =============================================================================

# TensorZero Integration
TENSORZERO_ENABLED=false
TENSORZERO_API_URL=http://localhost:3000
TENSORZERO_API_KEY=dev-tensorzero-key

# External Data Sources
ENABLE_NEWS_SENTIMENT=false
NEWS_API_KEY=dev-news-key

# Monitoring Integration
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9091

# =============================================================================
# ADVANCED AI SETTINGS
# =============================================================================

# Multi-Agent Configuration
ENABLE_MULTI_AGENT=true
NUM_DECISION_AGENTS=2  # Fewer agents for development
AGENT_CONSENSUS_THRESHOLD=0.5

# Learning Configuration
ENABLE_CONTINUOUS_LEARNING=true
LEARNING_RATE=0.02
EXPERIENCE_REPLAY_SIZE=100

# Model Fine-tuning
ENABLE_MODEL_FINETUNING=false
FINETUNING_DATA_PATH=./data/dev/finetuning
FINETUNING_INTERVAL=3600

# =============================================================================
# ENVIRONMENT SPECIFIC OVERRIDES
# =============================================================================

# Environment
ENVIRONMENT=development
