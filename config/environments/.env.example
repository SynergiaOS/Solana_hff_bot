# THE OVERMIND PROTOCOL - Environment Configuration Template
# Copy this file to .env.overmind and fill in your actual values
# NEVER commit .env.overmind to version control!

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
SNIPER_TRADING_MODE=paper  # paper or live
SNIPER_MAX_POSITION_SIZE=10000
SNIPER_MAX_DAILY_LOSS=1000

# ============================================================================
# API KEYS - SECURE STORAGE (REQUIRED)
# ============================================================================

# OpenAI API Key (REQUIRED for AI Brain)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional AI Providers
GROQ_API_KEY=your-groq-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Financial Data (optional)
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key-here

# ============================================================================
# SOLANA CONFIGURATION - MULTI-PROVIDER SETUP
# ============================================================================

# PRIMARY SOLANA RPC ENDPOINTS (PRODUCTION READY)
SOLANA_RPC_URL=https://your-quicknode-mainnet-url-here
SOLANA_WSS_URL=wss://your-quicknode-mainnet-wss-here

# DEVNET CONFIGURATION (for testing)
SOLANA_DEVNET_RPC_URL=https://your-quicknode-devnet-url-here
SOLANA_DEVNET_WSS_URL=wss://your-quicknode-devnet-wss-here

# MAINNET CONFIGURATION (for live trading)
QUICKNODE_MAINNET_RPC_URL=https://your-quicknode-mainnet-url-here
QUICKNODE_MAINNET_WSS_URL=wss://your-quicknode-mainnet-wss-here

# Helius - Data Analysis & Monitoring
HELIUS_MAINNET_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_HELIUS_API_KEY
HELIUS_MAINNET_WSS_URL=wss://rpc.helius.xyz/?api-key=YOUR_HELIUS_API_KEY
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_DEVNET_WSS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Jito - MEV Protection & Bundle Execution
JITO_MAINNET_RPC_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5

# API Keys (REQUIRED)
HELIUS_API_KEY=your-helius-api-key-here
QUICKNODE_API_KEY=your-quicknode-api-key-here
JITO_API_KEY=your-jito-api-key-here

# Wallet Configuration (REQUIRED for live trading)
SOLANA_WALLET_PRIVATE_KEY=your-base58-encoded-private-key-here

# ============================================================================
# DATABASE PASSWORDS (GENERATE SECURE PASSWORDS)
# ============================================================================
SNIPER_DB_PASSWORD=generate-secure-password-here
TENSORZERO_DB_PASSWORD=generate-secure-password-here
REDIS_PASSWORD=generate-secure-password-here
GRAFANA_ADMIN_PASSWORD=generate-secure-password-here

# ============================================================================
# DRAGONFLY CONFIGURATION
# ============================================================================
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6379
DRAGONFLY_URL=redis://localhost:6379

# ============================================================================
# TENSORZERO CONFIGURATION
# ============================================================================
TENSORZERO_GATEWAY_URL=http://localhost:3001
TENSORZERO_API_KEY=your-tensorzero-api-key-here

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================
RUST_LOG=info
PYTHON_LOG_LEVEL=INFO

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
DEPLOYMENT_ENV=development  # development, staging, production
CONTAINER_REGISTRY=ghcr.io/synergiaos
IMAGE_TAG=latest

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
ENABLE_API_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
ENABLE_CORS=false
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
