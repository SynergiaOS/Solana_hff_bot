# THE OVERMIND PROTOCOL - DEVNET CONFIGURATION
# Safe configuration for testing on Solana devnet

# ============================================================================
# TRADING CONFIGURATION - PAPER TRADING ONLY
# ============================================================================
SNIPER_TRADING_MODE=paper
SNIPER_LOG_LEVEL=info
SNIPER_SERVER_PORT=8080

# ============================================================================
# SOLANA DEVNET CONFIGURATION
# ============================================================================
SNIPER_SOLANA_RPC_URL=https://api.devnet.solana.com
SNIPER_SOLANA_WSS_URL=wss://api.devnet.solana.com

# Test wallet for devnet (safe - devnet funds only)
# Wallet Address: EqEvzWMY313Bbz33S1GoNfUf9TgRF8ynNgG8VTfT77ct
SNIPER_WALLET_PRIVATE_KEY=[248,171,142,165,61,0,229,77,38,102,123,42,184,41,86,102,18,180,120,60,140,181,236,47,232,167,33,92,104,245,221,251,205,131,143,130,95,118,218,32,137,52,202,69,103,69,196,109,29,202,38,222,161,253,168,2,55,165,67,102,22,19,166,201]

# ============================================================================
# RISK MANAGEMENT - CONSERVATIVE SETTINGS
# ============================================================================
SNIPER_MAX_POSITION_SIZE=0.1
SNIPER_MAX_DAILY_LOSS=0.05
SNIPER_RISK_TOLERANCE=low

# ============================================================================
# THE OVERMIND PROTOCOL - AI CONFIGURATION
# ============================================================================
OVERMIND_ENABLED=true
OVERMIND_AI_MODE=enabled
OVERMIND_AI_CONFIDENCE_THRESHOLD=0.8
OVERMIND_MAX_LATENCY_MS=50

# ============================================================================
# MULTI-WALLET CONFIGURATION
# ============================================================================
OVERMIND_MULTI_WALLET_ENABLED=true
OVERMIND_DEFAULT_WALLET=primary_wallet

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
SNIPER_DATABASE_URL=sqlite:./data/snipercor_devnet.db

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002

# ============================================================================
# DEVNET TESTING PARAMETERS
# ============================================================================
DEVNET_TEST_MODE=true
DEVNET_AIRDROP_ENABLED=true
DEVNET_TEST_STRATEGIES=soul_meteor,arbitrage,momentum

# ============================================================================
# SAFETY CHECKS
# ============================================================================
EMERGENCY_STOP_ENABLED=true
PAPER_TRADING_ENFORCED=true
REAL_FUNDS_PROTECTION=true
