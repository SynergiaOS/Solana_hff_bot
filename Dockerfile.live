# THE OVERMIND PROTOCOL - Live Trading Dockerfile
# Optimized for production deployment

FROM rust:1.75-slim as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Cargo files
COPY Cargo.toml Cargo.lock ./

# Copy source code
COPY src ./src

# Build the application in release mode
RUN cargo build --release

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1001 overmind

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/snipercor /app/snipercor

# Copy configuration files
COPY --chown=overmind:overmind config/ ./config/
RUN mkdir -p logs && chown overmind:overmind logs

# Switch to app user
USER overmind

# Expose port
EXPOSE 8082

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8082/health || exit 1

# Start the application
CMD ["./snipercor"]
