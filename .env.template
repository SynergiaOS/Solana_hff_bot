# =================================================
# 🔐 THE OVERMIND PROTOCOL - SECURE CONFIGURATION TEMPLATE
# =================================================
# 
# SECURITY WARNING: 
# - Never commit this file with real values to git
# - Copy to .env and fill with your actual credentials
# - Keep your private keys secure and never share them
#
# =================================================

# =================================================
# 🔐 OVERMIND VAULT SECURITY CONFIGURATION
# =================================================

# Security Mode (STANDARD/HIGH/MAXIMUM)
OVERMIND_SECURITY_MODE=MAXIMUM
OVERMIND_VAULT_ENABLED=true
OVERMIND_ENCRYPTION_ENABLED=true
OVERMIND_KEYRING_ENABLED=false
OVERMIND_FALLBACK_TO_ENV=true

# Multi-Wallet Security Configuration
OVERMIND_MULTI_WALLET_ENABLED=true
OVERMIND_DEFAULT_WALLET=primary_trading
OVERMIND_MANAGED_WALLETS=primary_trading:env:SNIPER_WALLET_PRIVATE_KEY:primary:medium:1.0

# Enhanced Multi-Wallet System
OVERMIND_AUTO_WALLET_GENERATION=true
OVERMIND_MAX_WALLETS_PER_STRATEGY=5
OVERMIND_WALLET_ROTATION_HOURS=24
OVERMIND_LOAD_BALANCING_ALGORITHM=PerformanceBased
OVERMIND_PERFORMANCE_MONITORING=true

# =================================================
# 🧠 THE OVERMIND PROTOCOL CONFIGURATION
# =================================================

# AI Brain Configuration
OVERMIND_AI_ENABLED=true
OVERMIND_AI_MODEL=gpt-4
OVERMIND_AI_CONFIDENCE_THRESHOLD=0.7
OVERMIND_AI_MAX_POSITION_SIZE=0.1

# Vector Memory Configuration
OVERMIND_VECTOR_DB_URL=http://localhost:8000
OVERMIND_VECTOR_COLLECTION=trading_memory
OVERMIND_MEMORY_RETENTION_DAYS=30

# TensorZero Configuration
TENSORZERO_API_URL=http://localhost:3000
TENSORZERO_API_KEY=your_tensorzero_api_key_here

# =================================================
# 🚀 RUST EXECUTOR CONFIGURATION
# =================================================

# Rust Executor Required Variables
SNIPER_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SECURITY: Replace with your actual private key
SNIPER_WALLET_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# === TRADING CONFIGURATION ===
# MISSION: Start with micro-trading, scale up gradually
SNIPER_MAX_POSITION_SIZE=0.0005
SNIPER_MAX_DAILY_LOSS=0.001
SNIPER_FORCE_REAL_MODE=false

# Risk Management
SNIPER_RISK_MAX_POSITION_PERCENTAGE=0.05
SNIPER_RISK_MAX_DAILY_LOSS_PERCENTAGE=0.10
SNIPER_RISK_STOP_LOSS_PERCENTAGE=0.05
SNIPER_RISK_TAKE_PROFIT_PERCENTAGE=0.20

# Trading Strategies
SNIPER_STRATEGY_TOKEN_SNIPING=true
SNIPER_STRATEGY_ARBITRAGE=true
SNIPER_STRATEGY_MOMENTUM=false
SNIPER_STRATEGY_MEV_PROTECTION=true

# AI Configuration
SNIPER_AI_CONFIDENCE_THRESHOLD=0.75
SNIPER_AI_MAX_TRADES_PER_HOUR=10
SNIPER_AI_ENABLE_LEARNING=true

# =================================================
# 🐍 PYTHON AI BRAIN CONFIGURATION
# =================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Perplexity Configuration
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Helius API Configuration
HELIUS_API_KEY=your_helius_api_key_here

# Jina AI Configuration
JINA_API_KEY=your_jina_api_key_here

# =================================================
# 🗄️ DATABASE CONFIGURATION
# =================================================

# DragonflyDB Configuration
DRAGONFLY_HOST=127.0.0.1
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=

# Chroma Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=overmind_memory

# PostgreSQL (if used)
DATABASE_URL=postgresql://user:password@localhost/overmind

# =================================================
# 📊 MONITORING & LOGGING
# =================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/overmind.log
LOG_MAX_SIZE=100MB
LOG_RETENTION_DAYS=30

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_ENDPOINT=/metrics

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8082
HEALTH_CHECK_ENDPOINT=/health

# =================================================
# 🌐 EXTERNAL SERVICES
# =================================================

# QuickNode Configuration (replace with your endpoints)
QUICKNODE_RPC_URL=https://your-quicknode-endpoint.quiknode.pro/your-api-key
QUICKNODE_WSS_URL=wss://your-quicknode-endpoint.quiknode.pro/your-api-key

# Jito Configuration
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_RELAYER_URL=https://mainnet.relayer.jito.wtf

# =================================================
# 🔧 DEVELOPMENT CONFIGURATION
# =================================================

# Development Mode
DEVELOPMENT_MODE=false
DEBUG_ENABLED=false
VERBOSE_LOGGING=false

# Testing Configuration
TEST_MODE=false
PAPER_TRADING_MODE=true
SIMULATION_MODE=false

# =================================================
# 🚨 EMERGENCY CONFIGURATION
# =================================================

# Emergency Stop Configuration
EMERGENCY_STOP_ENABLED=true
EMERGENCY_CONTACT_EMAIL=your-email@example.com
EMERGENCY_PHONE=+1234567890

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_FREQUENCY_HOURS=24
BACKUP_RETENTION_DAYS=30

